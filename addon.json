{
  "is-c3-addon": true,
  "sdk-version": 2,
  "type": "effect",
  "name": "Clouds Background (WebGPU)",
  "id": "gpt5_cloudsbackground",
  "version": "1.0.2.0",
  "author": "ChatGPT",
  "website": "https://construct.net",
  "documentation": "https://www.construct.net/en/make-games/manuals/addon-sdk/guide/configuring-effects",
  "description": "Procedural drifting clouds with adjustable density, scale, wind and opacity. WebGL+WebGPU. Uses layout-space so it scrolls with the camera.",
  "category": "other",
  "supported-renderers": [
    "webgl",
    "webgpu"
  ],
  "blends-background": true,
  "must-predraw": true,
  "animated": true,
  "preserves-opaqueness": false,
  "parameters": [
    {
      "id": "opacity",
      "type": "percent",
      "initial-value": 0.45,
      "uniform": "uOpacity",
      "interpolatable": true
    },
    {
      "id": "density",
      "type": "percent",
      "initial-value": 0.55,
      "uniform": "uDensity",
      "interpolatable": true
    },
    {
      "id": "scale",
      "type": "float",
      "initial-value": 1.1,
      "uniform": "uScale",
      "interpolatable": true
    },
    {
      "id": "speedX",
      "type": "float",
      "initial-value": 60,
      "uniform": "uSpeedX",
      "interpolatable": true
    },
    {
      "id": "speedY",
      "type": "float",
      "initial-value": 0,
      "uniform": "uSpeedY",
      "interpolatable": true
    },
    {
      "id": "drift",
      "type": "percent",
      "initial-value": 0.15,
      "uniform": "uDrift",
      "interpolatable": true
    },
    {
      "id": "bob",
      "type": "percent",
      "initial-value": 0.15,
      "uniform": "uBob",
      "interpolatable": true
    },
    {
      "id": "contrast",
      "type": "percent",
      "initial-value": 0.55,
      "uniform": "uContrast",
      "interpolatable": true
    },
    {
      "id": "softness",
      "type": "percent",
      "initial-value": 0.55,
      "uniform": "uSoftness",
      "interpolatable": true
    },
    {
      "id": "skyTint",
      "type": "percent",
      "initial-value": 0.5,
      "uniform": "uSkyTint",
      "interpolatable": true
    },
    {
      "id": "skyTop",
      "type": "color",
      "initial-value": [
        0.4,
        0.7,
        1
      ],
      "uniform": "uSkyTop",
      "interpolatable": true
    },
    {
      "id": "skyBottom",
      "type": "color",
      "initial-value": [
        0.2,
        0.4,
        0.6
      ],
      "uniform": "uSkyBottom",
      "interpolatable": true
    },
    {
      "id": "mask",
      "type": "percent",
      "initial-value": 0,
      "uniform": "uMask",
      "interpolatable": true
    },
    {
      "id": "maskInv",
      "type": "percent",
      "initial-value": 1,
      "uniform": "uMaskInv",
      "interpolatable": true
    },
    {
      "id": "maskinv",
      "type": "percent",
      "initial-value": 1,
      "uniform": "uMaskinv",
      "interpolatable": true
    },
    {
      "id": "seed",
      "type": "float",
      "initial-value": 0,
      "uniform": "uSeed",
      "interpolatable": true
    }
  ]
}
